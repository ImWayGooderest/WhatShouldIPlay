# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/wsip
MONGODB_TEST_URI=mongodb://localhost:27017/wsip_test

# Redis (for sessions and caching)
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# API Keys
STEAM_API_KEY=your_steam_api_key_here
GIANTBOMB_API_KEY=your_giantbomb_api_key_here

# API Rate Limiting
GIANTBOMB_DELAY_MS=15000

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
