{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend Dev",
      "type": "npm",
      "script": "dev",
      "path": "backend/",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Start Frontend Dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend/",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Build Backend",
      "type": "npm",
      "script": "build",
      "path": "backend/",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build Frontend",
      "type": "npm",
      "script": "build",
      "path": "frontend/",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Test Backend",
      "type": "npm",
      "script": "test",
      "path": "backend/",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker Compose Up",
      "type": "shell",
      "command": "docker-compose up -d",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker Compose Down",
      "type": "shell",
      "command": "docker-compose down",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
